<Window x:Class="ColorNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ColorNotes.Converters"
        xmlns:models="clr-namespace:ColorNotes.Models"
        xmlns:vm="clr-namespace:ColorNotes.ViewModels"
        Title="Color Notes" Width="1180" Height="760" MinWidth="900" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#FFF9F6F0"
        FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:NoteColorToBrushConverter x:Key="NoteColorBrush" />
        <conv:NoteKindToGlyphConverter x:Key="NoteKindGlyph" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF3E3B37" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#24000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF514B45" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavShell" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavShell" Property="Background" Value="#0F000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavShell" Property="Background" Value="#1A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF292622" />
            <Setter Property="CaretBrush" Value="#FF292622" />
            <Setter Property="SelectionBrush" Value="#55382F25" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTextNoteCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewChecklistCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="330" MinWidth="280" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#FFF2EDE5" BorderBrush="#14000000" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,25,18,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#FFFFD453">
                            <Image Source="Assets/ColorNotes.png" Margin="4" />
                        </Border>
                        <TextBlock Text="Color Notes" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="17"
                                   VerticalAlignment="Center" Foreground="#FF292622" />
                    </StackPanel>
                    <TextBlock Text="Private · Offline" Margin="44,3,0,0" FontSize="11" Foreground="#FF8B8178" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Command="{Binding SelectSectionCommand}" CommandParameter="Notes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Width="28" /><TextBlock Text="Notes" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding SelectSectionCommand}" CommandParameter="Reminders">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Width="28" /><TextBlock Text="Reminders" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding SelectSectionCommand}" CommandParameter="Archive">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Segoe UI Symbol" Width="28" /><TextBlock Text="Archive" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding SelectSectionCommand}" CommandParameter="Trash">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="28" /><TextBlock Text="Trash" /></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="16,12,16,20" Padding="12" CornerRadius="10" Background="#BFFFFFFF">
                    <StackPanel>
                        <TextBlock Text="QUICK CAPTURE" FontSize="10" FontWeight="SemiBold" Foreground="#FF8B8178" />
                        <TextBlock Text="Ctrl + N" Margin="0,7,0,0" Foreground="#FF514B45" FontSize="12" />
                        <TextBlock Text="New text note" Foreground="#FF8B8178" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Note list -->
        <Border Grid.Column="1" Background="#FFFCFAF7" BorderBrush="#14000000" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="20,22,16,12">
                    <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#FF292622" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" ToolTip="New checklist (Ctrl+Shift+N)" Command="{Binding NewChecklistCommand}" Content="☑" FontFamily="Segoe UI Symbol" />
                        <Button Style="{StaticResource IconButton}" ToolTip="New note (Ctrl+N)" Command="{Binding NewTextNoteCommand}" Content="&#xE710;" Background="#FFFFD453" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Margin="18,0,18,14" Height="40" CornerRadius="10" Background="#FFF1EEE9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FF8B8178" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="0,0,10,0"
                                 FontSize="13" Foreground="#FF292622" ToolTip="Search all text in this section (Ctrl+F)" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" ItemsSource="{Binding NotesView}" SelectedItem="{Binding SelectedNote}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" Padding="12,0,12,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="3,3,3,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="12" Padding="3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#10000000" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#1B000000" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
                            <Border Padding="14,12" CornerRadius="10" Background="{Binding Color, Converter={StaticResource NoteColorBrush}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#FF292622" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FF6C6258" Margin="8,0,0,0"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Preview}" Margin="0,7,0,0" FontSize="12" Foreground="#B8504942"
                                               MaxHeight="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource NoteKindGlyph}}" FontFamily="Segoe UI Symbol" FontSize="11" Foreground="#FF7C7269" />
                                        <TextBlock Text="{Binding UpdatedLabel}" Margin="6,0,0,0" FontSize="10" Foreground="#FF7C7269" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="Your notes save automatically" HorizontalAlignment="Center"
                           Margin="0,8,0,14" FontSize="10" Foreground="#FF9B9289" />
            </Grid>
        </Border>

        <!-- Editor -->
        <Grid Grid.Column="2" Background="{Binding SelectedNote.Color, Converter={StaticResource NoteColorBrush}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border BorderBrush="#14000000" BorderThickness="0,0,0,1">
                <DockPanel Margin="18,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE823;" ToolTip="Set reminder" Click="Reminder_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Pin or unpin" Command="{Binding TogglePinCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="▣" FontFamily="Segoe UI Symbol" ToolTip="Archive or unarchive" Command="{Binding ArchiveCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Move to trash" Command="{Binding TrashCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#77382F25" />
                        <TextBlock Text="Saved automatically" Margin="8,0,0,0" Foreground="#AA514B45" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="44,36,44,24">
                <StackPanel MaxWidth="760">
                    <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"
                             FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" AcceptsReturn="False"
                             AutomationProperties.Name="Note title" />
                    <TextBlock Text="{Binding SelectedNote.UpdatedLabel, StringFormat=Edited {0}}" Margin="1,8,0,24" FontSize="11" Foreground="#9A514B45" />

                    <TextBox Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="380"
                             VerticalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="True" AutomationProperties.Name="Note body">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource EditorTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNote.IsTextNote}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Visibility="{Binding SelectedNote.IsChecklist, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SelectedNote.ChecklistItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Width="18" Height="18" />
                                        <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16" Padding="0,6" VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource EditorTextBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE74D;"
                                                ToolTip="Remove item" Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding AddChecklistItemCommand}" Margin="28,10,0,0" HorizontalAlignment="Left" Background="Transparent"
                                BorderThickness="0" Foreground="#CC514B45" Padding="4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text=" Add item" Margin="7,0,0,0" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#14000000" BorderThickness="0,1,0,0" Padding="20,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Restore" Command="{Binding RestoreCommand}" Padding="14,7" Margin="4,0" Background="#22FFFFFF" BorderBrush="#22000000"
                                Visibility="{Binding SelectedNote.IsTrashed, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Delete forever" Command="{Binding DeleteForeverCommand}" Padding="14,7" Margin="4,0" Background="#22FFFFFF" BorderBrush="#22000000"
                                Foreground="#FF9D2929" Visibility="{Binding SelectedNote.IsTrashed, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding SelectedNote.ReminderLabel}" Click="Reminder_Click"
                            Margin="8,0,14,0" Padding="10,5" Background="#18FFFFFF" BorderBrush="#22000000"
                            Foreground="#BB514B45" ToolTip="Set or change reminder" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="COLOR" FontSize="9" FontWeight="SemiBold" Foreground="#99514B45" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Width="22" Height="22" Margin="3" Background="#FFFFD453" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Yellow" />
                        <Button Width="22" Height="22" Margin="3" Background="#FFFFA984" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Coral" />
                        <Button Width="22" Height="22" Margin="3" Background="#FFFF92B4" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Rose" />
                        <Button Width="22" Height="22" Margin="3" Background="#FFC4A0F3" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Grape" />
                        <Button Width="22" Height="22" Margin="3" Background="#FF8DC9F3" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Ocean" />
                        <Button Width="22" Height="22" Margin="3" Background="#FF8ED5AD" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Mint" />
                        <Button Width="22" Height="22" Margin="3" Background="#FFAEB8C4" BorderThickness="0" Command="{Binding SetColorCommand}" CommandParameter="Slate" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                <Border Width="72" Height="72" CornerRadius="22" Background="#FFFFEAA0" HorizontalAlignment="Center">
                    <Image Source="Assets/ColorNotes.png" Margin="9" />
                </Border>
                <TextBlock Text="A quiet place for your thoughts" FontSize="20" FontWeight="SemiBold" Foreground="#FF514B45" TextAlignment="Center" Margin="0,20,0,0" />
                <TextBlock Text="Create a note or checklist. Everything is saved privately on this PC." TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF8B8178" Margin="0,10,0,20" />
                <Button Content="Create a note" Command="{Binding NewTextNoteCommand}" Background="#FFFFD453" Foreground="#FF433A20" BorderThickness="0" Padding="18,10" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
